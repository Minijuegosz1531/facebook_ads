# ─────────────────────────────────────────────────────────────
# Meta Ads Platform — environment variables
# Copy to .env and fill in. Defaults work in STUB mode (no real services).
# ─────────────────────────────────────────────────────────────

# Stub mode: when true, outbound adapters return deterministic fake data
# and the API runs with an in-memory repository (no Postgres/Redis needed).
USE_STUBS=true

# Meta
META_SYSTEM_USER_TOKEN=EAABxx...
META_BUSINESS_ID=123456789

# IA
ANTHROPIC_API_KEY=sk-ant-...
HF_API_KEY=hf_...
HF_API_SECRET=hf_secret_...

# Base de datos
DATABASE_URL=postgresql+asyncpg://metaads:metaads@localhost:5432/metaads

# Redis
REDIS_URL=redis://localhost:6379

# Storage
GCS_BUCKET_NAME=meta-ads-platform-assets
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# ─── Next.js (apps/web) ───
# URL of the FastAPI microservice the web proxies to.
API_BASE_URL=http://localhost:8000
# When 1, Next.js API routes serve in-memory mock data (used by E2E).
MOCK_API=1
